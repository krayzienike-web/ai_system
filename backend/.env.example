# Copy to backend/.env for local development. Without FAI_ENV the settings assume production
# and refuse the built-in development JWT secret.
FAI_ENV=dev
# FAI_JWT_SECRET=...            # required outside dev/test, at least 32 characters
# FAI_REDIS_URL=redis://localhost:6379
# The assistant's model (ADR 0005): off until the Claude API key comes (Q12).
# FAI_AI_PROVIDER=claude
# ANTHROPIC_API_KEY=...
