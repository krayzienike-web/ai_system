# The demo stand's secrets: copy to deploy/.env and fill in. deploy/.env is never committed.
DOMAIN=demo.example.ru
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# The key of cashiers' codes, 32+ random characters (openssl rand -hex 32). Never changed afterwards: a new key
# gives every cashier a new code.
CASHIER_KEY=
# The password of the demo logins (admin@demo.local, director1@demo.local, …), given to the people invited.
DEMO_PASSWORD=
# The day the demo lives in (its data ends two days before) and its nightly rebuild.
DEMO_TODAY=2026-10-20
DEMO_RESET_NIGHTLY=true
# The assistant's model: off until the Claude API key comes (Q12); then AI_PROVIDER=claude and the key.
AI_PROVIDER=off
ANTHROPIC_API_KEY=
