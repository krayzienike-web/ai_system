# The pilot with real data (stage 8, step 7; deploy/README.md, «Пилот»): copy to deploy/.env on the pilot's
# server and fill in. No DEMO_* here: «today» is the network's real day, nothing is rebuilt at night.
# deploy/.env is never committed.
DOMAIN=pilot.example.ru
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
# 32+ random characters each: openssl rand -hex 32. Not the demo stand's values.
JWT_SECRET=
# The key of cashiers' codes. Never changed afterwards: a new key gives every cashier a new code.
CASHIER_KEY=
# The network's time zone: «today» and the weekly digest follow it.
TIMEZONE=Europe/Moscow
# The assistant's model: off until the Claude API key comes (Q12); then AI_PROVIDER=claude and the key.
AI_PROVIDER=off
ANTHROPIC_API_KEY=
